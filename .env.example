# docs/prd/07-external-api-integration.md 참조.
# 실제 값은 .env.local에 입력하고 커밋하지 마세요.

# AI 추천 로직 (Must) — LLM_PROVIDER: gemini(기본) | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# 비워두면 gemini-flash-lite-latest (품질 우선이면 gemini-flash-latest)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# 비워두면 claude-opus-5
ANTHROPIC_MODEL=

# 장소 검색 (Must) — 네이버 개발자센터
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 지도 렌더링 / 길찾기 / Geocoding (Must) — Naver Cloud Platform
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=
# 브라우저 지도 SDK용 — NCP_MAP_CLIENT_ID와 같은 값 (공개되어도 안전, 도메인 등록으로 보호)
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=

# 대중교통 길찾기 (Should)
ODSAY_API_KEY=

# 관광지/숙소 상세, 축제, 반려동물 동반정보 (Must/Should) — 공공데이터포털 TourAPI
TOUR_API_KEY=

# 날씨 (Should) — 공공데이터포털 기상청 단기예보
WEATHER_API_KEY=

# 로그인 전용 (Must) — 카카오 로그인
KAKAO_REST_API_KEY=

# Firebase (Must)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
