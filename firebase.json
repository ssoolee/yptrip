{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "yptour",
    "public": "hosting-redirect",
    "redirects": [
      { "source": "/", "destination": "https://yptrip--ypcourse.asia-east1.hosted.app/", "type": 302 },
      { "source": "/:path*", "destination": "https://yptrip--ypcourse.asia-east1.hosted.app/:path*", "type": 302 }
    ]
  },
  "apphosting": {
    "backendId": "yptrip",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env.local",
      ".playwright-mcp",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
}
